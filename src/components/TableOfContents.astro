---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<nav class="toc" aria-label="Table of contents">
  <details open>
    <summary class="toc-title">On this page</summary>
    <ul class="toc-list">
      {headings.map(heading => (
        <li class="toc-item">
          <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
        </li>
      ))}
    </ul>
  </details>
</nav>
